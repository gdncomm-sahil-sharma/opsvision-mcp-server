%% ─── 1. System context ──────────────────────────────────────────────────────
flowchart TB
    Agent["Operations / Support Agent<br/><small>(LLM running on harness)</small>"]:::agent

    subgraph Server["opsvision-mcp-server (this repo)"]
        direction TB
        Tools["Tool layer<br/><small>13 @Tool methods</small>"]
        Repos["Repository layer<br/><small>12 repositories</small>"]
        JDBC["JdbcClient × 3<br/><small>Hikari pools</small>"]
        Tools --> Repos --> JDBC
    end

    subgraph DBs["PostgreSQL 13 — read replicas in QA2"]
        direction LR
        Stockholm[("stockholm_marunda_restore<br/><small>DB 413 · pick_package · sales_order ·<br/>picker · pick_list · packing_order</small>")]
        Inventory[("warehouse_inventory_marunda<br/><small>DB 417 · warehouse_item_master · bin ·<br/>stock_history</small>")]
        Movement[("warehouse_stock_movement_marunda<br/><small>DB 416 · picking_task ·<br/>picking_task_request</small>")]
    end

    Agent -- "MCP / JSON-RPC 2.0<br/>over Streamable HTTP" --> Server
    JDBC --> Stockholm
    JDBC --> Inventory
    JDBC --> Movement

    classDef agent fill:#fff8c5,stroke:#9a6700,stroke-width:1.5px;
    classDef default rx:6,ry:6;


%% ─── 2. High-level four-layer architecture ──────────────────────────────────
flowchart TB
    L1["<b>Transport</b><br/>spring-ai-starter-mcp-server-webmvc<br/><small>MCP 2025-03-26 over Streamable HTTP · :8081/mcp</small>"]
    L2["<b>Tool layer · 13 @Tool methods · McpToolsConfig</b><br/><small>Composes evidence packs · runs pure-Java derivations<br/>(lifecycle stages · boolean signals · queue-rank · freshness)</small>"]
    L3["<b>Repository layer · 12 @Repository classes</b><br/><small>JdbcClient + named-param SQL + custom RecordRowMapper<br/>@Transactional(readOnly = true) on every method</small>"]
    L4["<b>DataSource layer · DataSourcesConfig · 3 Hikari pools</b><br/><small>stockholmJdbcClient · inventoryJdbcClient · movementJdbcClient<br/>read-only · 5 conns · init-SQL: SET default_transaction_read_only = on</small>"]
    L5[("PostgreSQL 13 · 3 databases · multi-host failover URL<br/><small>central-postgres13-{01,02}.qa2-sg.cld:5432 · targetServerType=master</small>")]
    L1 --> L2 --> L3 --> L4 --> L5

    classDef default rx:8,ry:8,stroke-width:1.2px;


