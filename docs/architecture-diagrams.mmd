%% ─── 4. SignalKind dominance hierarchy ──────────────────────────────────────
flowchart TB
    A["<b>OPERATOR_OVERRIDE</b><br/><small>Operator-set, dominates state</small><br/><small>e.g. isRejected · isInactive</small>"]:::override
    B1["<b>BLOCKER_EXTERNAL</b><br/><small>Waiting on upstream system</small><br/><small>e.g. isStorageNotAvailable</small>"]:::blocker
    B2["<b>BLOCKER_INTERNAL</b><br/><small>Capacity / configuration limit</small><br/><small>e.g. hasEligiblePickersButNoneAvailable</small>"]:::blocker
    S["<b>STAGE</b><br/><small>Lifecycle state of the artefact</small><br/><small>e.g. isReadyForManualPicking · isPartialPackage</small>"]:::stage
    C["<b>CONTEXT</b><br/><small>Background fact, never the headline</small><br/><small>e.g. isInBatchOrWave · hasMultipleSourceAreas</small>"]:::context

    A == "dominates" ==> B1
    A == "dominates" ==> B2
    B1 == "dominates" ==> S
    B2 == "dominates" ==> S
    S == "dominates" ==> C

    classDef override fill:#ffebe9,stroke:#cf222e,color:#82071e,stroke-width:1.5px;
    classDef blocker  fill:#fff8c5,stroke:#bf8700,color:#633c01,stroke-width:1.5px;
    classDef stage    fill:#dafbe1,stroke:#1a7f37,color:#0a3622,stroke-width:1.5px;
    classDef context  fill:#eaeef2,stroke:#6e7781,color:#24292f,stroke-width:1.5px;
    classDef default  rx:6,ry:6;


